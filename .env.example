# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
# Credenciais nunca são gravadas em .devmate/config.toml.
OPENAI_API_KEY=
DEVMATE_PROVIDER=mock
DEVMATE_MODEL=

# --- Somente para `devmate serve` exposto fora de localhost (deploy) ---
# Sem DEVMATE_API_KEY, qualquer origem permitida por DEVMATE_CORS_ORIGINS
# consegue ler e escrever no repositório montado. Gere com `openssl rand -hex 32`.
DEVMATE_API_KEY=
# Origens do frontend publicado, separadas por vírgula. Nunca "*".
DEVMATE_CORS_ORIGINS=
